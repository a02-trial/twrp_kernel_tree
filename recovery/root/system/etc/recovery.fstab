#<src>                                             <mnt_point>    <type>      <mnt_flags and options>    <fs_mgr_flags>
system                                             /system         ext4        ro,barrier=1,discard      avb=vbmeta,logical,first_stage_mount [cite: 25]
vendor                                             /vendor         ext4        ro,barrier=1,discard      avb,logical,first_stage_mount [cite: 25]
product                                            /product        ext4        ro,barrier=1,discard      avb,logical,first_stage_mount [cite: 26]
odm                                                /odm            ext4        ro,barrier=1,discard      avb,logical,first_stage_mount [cite: 27]

/dev/block/platform/bootdevice/by-name/boot        /boot           emmc        defaults                  recoveryonly 
/dev/block/platform/bootdevice/by-name/recovery    /recovery       emmc        defaults                  recoveryonly 
/dev/block/platform/bootdevice/by-name/userdata    /data           f2fs        defaults                  wait,length=-16384,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,encryptable=footer 
/dev/block/platform/bootdevice/by-name/cache       /cache          ext4        defaults                  recoveryonly [cite: 29]
/dev/block/platform/bootdevice/by-name/sec_efs     /efs            ext4        defaults                  recoveryonly [cite: 29]
/dev/block/platform/bootdevice/by-name/carrier     /carrier        ext4        defaults                  recoveryonly [cite: 29]
/dev/block/platform/bootdevice/by-name/hidden      /preload        ext4        defaults                  recoveryonly [cite: 30]
/dev/block/platform/bootdevice/by-name/misc        /misc           emmc        defaults                  recoveryonly [cite: 30]
/dev/block/platform/bootdevice/by-name/md_udc      /metadata       ext4        defaults                  wait,first_stage_mount [cite: 30]

# FOTA
/dev/block/platform/bootdevice/by-name/apnhlos     /modem          emmc        defaults                  recoveryonly [cite: 31]
/dev/block/platform/bootdevice/by-name/modem       /mdm            emmc        defaults                  recoveryonly [cite: 31]
/dev/block/platform/bootdevice/by-name/dsp         /dsp            emmc        defaults                  recoveryonly [cite: 32]
