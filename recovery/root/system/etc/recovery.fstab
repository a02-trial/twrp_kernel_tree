/dev/block/platform/bootdevice/by-name/keydata     /keydata        ext4        defaults                  recoveryonly 
/dev/block/platform/bootdevice/by-name/keyrefuge   /keyrefuge      ext4        defaults                  recoveryonly 
/dev/block/platform/bootdevice/by-name/gz1         /gz1            emmc        default                   recoveryonly 
